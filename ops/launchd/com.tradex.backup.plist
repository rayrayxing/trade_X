<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Nightly encrypted restic backup to the external drive at 06:30 local time (after the US close, before Asia opens). -->
    <key>Label</key>
    <string>com.tradex.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__TRADEX_HOME__/ops/bin/backup.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__TRADEX_HOME__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TRADEX_HOME</key>
        <string>__TRADEX_HOME__</string>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>ExitTimeOut</key>
    <integer>300</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/tradex/backup.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/tradex/backup.err.log</string>
</dict>
</plist>
