<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Timer job, not a service: every 5 minutes checks the services and pings healthchecks.io (dead-man switch). -->
    <key>Label</key>
    <string>com.tradex.heartbeat</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__TRADEX_HOME__/ops/bin/healthcheck.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__TRADEX_HOME__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TRADEX_HOME</key>
        <string>__TRADEX_HOME__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>ExitTimeOut</key>
    <integer>60</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/tradex/heartbeat.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/tradex/heartbeat.err.log</string>
</dict>
</plist>
