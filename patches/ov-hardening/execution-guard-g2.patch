 def test_accounts_file_is_protected():
     from pathlib import Path
     assert "config/accounts.yaml" in Path("config/protected_paths.txt").read_text().split()
+
+
+# --- a verdict is a budget (G2) -------------------------------------------------------------------
+
+def test_a_cancelled_entry_gives_its_quantity_back_to_the_verdict():
+    from dataclasses import replace
+    v = _FakeVenue(_guard())                                              # the verdict allows 10
+    v.place(_entry(qty=6))
+    second = replace(_entry(qty=6), client_order_id="d1-entry-r1")
+    with pytest.raises(OrderRefused, match="already placed"):
+        v.place(second)
+    assert v.cancel("d1-entry")                                           # the core's resize: cancel, then re-place
+    assert v.place(second) == "d1-entry-r1"
+
+
+def test_the_same_client_order_id_is_not_counted_twice():
+    v = _FakeVenue(_guard())
+    assert v.place(_entry(qty=10)) == v.place(_entry(qty=10)) == "d1-entry"
+
+
+def test_a_venue_error_does_not_burn_the_verdict():
+    class Down(_FakeVenue):
+        fail = True
+
+        def _submit(self, req):
+            if self.fail:
+                raise ConnectionError("venue down")
+            return super()._submit(req)
+    v = Down(_guard())
+    with pytest.raises(ConnectionError):
+        v.place(_entry(qty=10))
+    v.fail = False
+    assert v.place(_entry(qty=10)) == "d1-entry"
+
+
+def test_guard_broker_cancel_releases_too():
+    from dataclasses import replace
+    g = GuardedBroker(SimBroker(10_000, ZERO_COST, bar=DAY, account_id="acct-1"), _guard())
+    g.place(_entry(qty=10))
+    with pytest.raises(OrderRefused):
+        g.place(replace(_entry(qty=1), client_order_id="d1-entry-2"))
+    assert g.cancel("d1-entry")
+    g.place(replace(_entry(qty=1), client_order_id="d1-entry-2"))
