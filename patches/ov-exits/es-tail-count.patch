+"""ESModel counts its 2.5% tail without floating-point drift (patches/ov-exits/es-tail-count.patch).
+
+600 * (1 - 0.975) is 15.000000000000013 in floating point, so ceil() gave 16 worst days instead of 15 and the
+expected shortfall came out slightly too small whenever the history length makes the tail an exact whole number.
+"""
+import numpy as np
+import pandas as pd
+import pytest
+
+from tradex.risk.exposure import ESModel
+
+
+def test_tail_of_600_days_is_15_worst_days():
+    r = np.zeros(600)
+    r[:15] = -0.10
+    rets = pd.DataFrame({"FX:JPY": r}, index=pd.date_range("2020-01-01", periods=600, freq="D", tz="UTC"))
+    es = ESModel(rets, window=600, min_hist=250).es({"FX:JPY": 1_000.0})
+    assert es == pytest.approx(100.0)
