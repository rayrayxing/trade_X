@@ -0,0 +1,182 @@
+"""Option rules for the risk gate and the order guard (protected path).
+
+Three things the stock-shaped gate got wrong for options, all fixed here (Ray, 4 Oct 2026):
+
+1. **The x100 multiplier.** One US equity option contract covers 100 shares. Quantity is in
+   contracts and prices are per share, so every USD figure (risk per unit, notional, heat,
+   leverage) is price x multiplier x quantity. The multiplier comes from ``options.multiplier``
+   in config/risk/policy.yaml.
+2. **A naked short call has no ceiling.** It is sized on a gap-stressed loss: the buy-to-close
+   stop triggers and then the underlying gaps a further ``gap_pct`` (20%, floored in code) past
+   the stop level before the order fills. ``premium_after_gap`` is the same formula as
+   ``tradex.options.sizing.premium_after_gap``; the two are checked against each other in
+   tests/test_options_risk.py.
+3. **A naked call always has a stop, and is kept off earnings and heavily shorted names.** Both
+   the gate and the order guard refuse a short call without a buy-to-close stop above the credit.
+
+This module deliberately imports nothing from ``tradex.options`` (that package is not protected,
+so a gate that depended on it would be only as safe as its least-reviewed file).
+"""
+from __future__ import annotations
+
+import datetime as dt
+import math
+import re
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+DEFAULT_POLICY = Path(__file__).resolve().parents[2] / "config" / "risk" / "policy.yaml"
+GAP_PCT_FLOOR = 0.20                  # not configurable downwards: lowering it takes a code change
+_SYMBOL = re.compile(r"^(?:US\.)?(?P<root>[A-Z][A-Z0-9.]{0,5}?)(?P<d>\d{6})(?P<right>[CP])(?P<k>\d+)$")
+
+
+def load_options_policy(path: str | Path | None = None) -> dict[str, Any] | None:
+    """``options`` section of the risk policy, or None when options are not enabled."""
+    doc = yaml.safe_load(Path(path or DEFAULT_POLICY).read_text()) or {}
+    return doc.get("options") or None
+
+
+@dataclass(frozen=True)
+class OptionSymbol:
+    underlying: str
+    expiry: dt.date
+    right: str                        # "C" or "P"
+    strike: float
+
+
+def parse_option_symbol(symbol: str) -> OptionSymbol | None:
+    """Parse a moomoo option code (``US.AAPL261016C150000``); None when ``symbol`` is not one."""
+    m = _SYMBOL.match(symbol.strip().upper())
+    if not m:
+        return None
+    d = m["d"]
+    try:
+        expiry = dt.date(2000 + int(d[:2]), int(d[2:4]), int(d[4:6]))
+    except ValueError:
+        return None
+    return OptionSymbol(m["root"], expiry, m["right"], int(m["k"]) / 1000.0)
+
+
+@dataclass(frozen=True)
+class OptionInfo:
+    """What the gate needs to know about the option behind a plan (the planner fills it in)."""
+    right: str                        # "C" or "P"
+    strike: float
+    underlying: str
+    underlying_price: float
+    delta: float | None = None
+    # naked calls
+    underlying_at_stop: float | None = None     # underlying level at which the buy-to-close stop triggers
+    iv: float | None = None                     # implied vol as a fraction, for repricing after the gap
+    years: float | None = None                  # years to expiry
+    rate: float = 0.0
+    div_yield: float = 0.0
+    today: dt.date | None = None
+    holding_end: dt.date | None = None          # last date the position may still be open
+    earnings_known: bool = False                # the calendar answered (even if "no report scheduled")
+    earnings_date: dt.date | None = None
+    short_interest_pct_float: float | None = None
+    days_to_cover: float | None = None
+
+
+# --- pricing (call only; copied, not imported) ----------------------------------------------------
+
+def _ncdf(x: float) -> float:
+    return 0.5 * (1.0 + math.erf(x / math.sqrt(2.0)))
+
+
+def call_price(spot: float, strike: float, years: float, iv: float, rate: float = 0.0, q: float = 0.0) -> float:
+    if years <= 1e-9 or iv <= 0:
+        return max(spot * math.exp(-q * max(years, 0.0)) - strike * math.exp(-rate * max(years, 0.0)), 0.0)
+    s = iv * math.sqrt(years)
+    d1 = (math.log(spot / strike) + (rate - q + 0.5 * iv * iv) * years) / s
+    return spot * math.exp(-q * years) * _ncdf(d1) - strike * math.exp(-rate * years) * _ncdf(d1 - s)
+
+
+def premium_after_gap(strike: float, stop_premium: float, underlying_at_stop: float, gap_pct: float,
+                      iv: float | None = None, years: float | None = None, rate: float = 0.0,
+                      div_yield: float = 0.0) -> tuple[float, float]:
+    """(underlying after the gap, call premium after the gap), conservative.
+
+    With volatility inputs: the larger of the Black-Scholes price at the gapped level and
+    intrinsic value plus the time value the call still had at the stop. Without: the hard bound
+    ``stop_premium + (S_gap - S_stop)`` (a call gains at most US$1 per US$1 of underlying).
+    """
+    s_gap = underlying_at_stop * (1.0 + gap_pct)
+    if not iv or not years or iv <= 0 or years <= 0:
+        return s_gap, stop_premium + (s_gap - underlying_at_stop)
+    extrinsic = max(stop_premium - max(underlying_at_stop - strike, 0.0), 0.0)
+    floor = max(s_gap - strike, 0.0) + extrinsic
+    return s_gap, max(call_price(s_gap, strike, years, iv, rate, div_yield), floor)
+
+
+# --- sizing ---------------------------------------------------------------------------------
+
+def option_unit_risk(entry: float, stop: float | None, direction: int, info: OptionInfo, pol: dict[str, Any]
+                     ) -> tuple[float | None, dict[str, Any], str | None]:
+    """(USD risk per contract before fees, details for the verdict, refusal reason or None).
+
+    Long call / long put: the whole premium, ``entry x multiplier`` (options gap through stops).
+    Naked short call: the gap-stressed loss. Short puts are refused.
+    """
+    mult = float(pol["multiplier"])
+    detail: dict[str, Any] = {"multiplier": mult, "right": info.right, "entry_premium": entry,
+                              "stop_premium": stop, "underlying": info.underlying}
+    if entry <= 0:
+        return None, detail, "option premium must be positive"
+    if direction > 0:
+        detail["structure"] = "long_call" if info.right == "C" else "long_put"
+        detail["unit_risk_usd"] = entry * mult
+        return entry * mult, detail, None
+    if info.right != "C":
+        return None, detail, "short puts are not permitted"
+    n = pol.get("naked_call") or {}
+    detail["structure"] = "naked_call"
+    if not n.get("enabled", False):
+        return None, detail, "naked calls are not enabled in the risk policy"
+    if stop is None or stop <= entry:
+        return None, detail, "naked call needs a buy-to-close stop above the credit received"
+    if info.underlying_at_stop is None or info.underlying_at_stop <= 0:
+        return None, detail, "naked call: underlying level at the stop unknown, the gap cannot be sized"
+    gap = max(float(n.get("gap_pct", GAP_PCT_FLOOR)), GAP_PCT_FLOOR)
+    s_gap, p_gap = premium_after_gap(info.strike, stop, info.underlying_at_stop, gap, info.iv, info.years,
+                                     info.rate, info.div_yield)
+    fill = p_gap * (1.0 + float(n.get("exec_cushion_pct", 0.0)))
+    unit = (fill - entry) * mult
+    detail.update(gap_pct=gap, underlying_at_stop=info.underlying_at_stop, underlying_after_gap=s_gap,
+                  premium_after_gap=p_gap, fill_after_gap=fill, unit_risk_usd=unit,
+                  stop_loss_usd=(stop - entry) * mult)
+    return unit, detail, None
+
+
+def naked_call_blockers(info: OptionInfo, n: dict[str, Any]) -> list[str]:
+    """Reasons a naked call may not be opened: earnings in the holding window, squeeze risk, unknown data.
+
+    Each reason starts with its category (``earnings:``, ``squeeze:``, ``unknown_data:``).
+    """
+    out: list[str] = []
+    known_required = bool(n.get("require_known_data", True))
+    if n.get("block_through_earnings", True):
+        if not info.earnings_known:
+            if known_required:
+                out.append("unknown_data: earnings calendar has no answer")
+        elif info.earnings_date is not None:
+            if info.today is None or info.holding_end is None:
+                out.append("unknown_data: holding window not supplied, earnings overlap cannot be checked")
+            else:
+                limit = info.holding_end + dt.timedelta(days=int(n.get("earnings_buffer_days", 1)))
+                if info.today <= info.earnings_date <= limit:
+                    out.append(f"earnings: report on {info.earnings_date} falls inside the holding window")
+    si, dtc = info.short_interest_pct_float, info.days_to_cover
+    if si is None and dtc is None:
+        if known_required:
+            out.append("unknown_data: short-interest data unknown")
+    else:
+        if si is not None and si > float(n.get("max_short_interest_pct_float", 20.0)):
+            out.append(f"squeeze: short interest {si:.0f}% of float")
+        if dtc is not None and dtc > float(n.get("max_days_to_cover", 5.0)):
+            out.append(f"squeeze: {dtc:.1f} days to cover")
+    return out
