+# Options (long calls, long puts, naked short calls). Added by patches/options-order-guard.patch.
+options:
+  multiplier: 100              # shares per US equity option contract: every option USD figure uses it
+  naked_call:
+    enabled: true
+    stop_required: true        # a buy-to-close stop above the credit, always set (gate and order guard both refuse without)
+    gap_pct: 0.20              # sized as if the underlying gaps this far past the stop; code floors it at 0.20
+    exec_cushion_pct: 0.03     # the buy-to-close pays the ask plus slippage: half spread 2% + slippage 1%
+    block_through_earnings: true
+    earnings_buffer_days: 1    # keep this many days clear of a report
+    max_short_interest_pct_float: 20.0
