index 0000000..ee27a2a
--- /dev/null
+++ b/tests/test_options_risk.py
@@ -0,0 +1,375 @@
+"""Risk gate and order guard for options: x100 multiplier, naked-call stop, 20% gap sizing.
+
+Added by patches/options-order-guard.patch; the first test class checks the gate, the second the
+guard, the third that the protected copy of the gap formula agrees with tradex.options.sizing.
+"""
+import datetime as dt
+
+import pandas as pd
+import pytest
+
+from tradex.core.interfaces import BrokerPosition, OrderRequest
+from tradex.core.records import TradePlan, Verdict
+from tradex.execution.checks import SanityPolicy, sanity_check
+from tradex.execution.guard import OrderGuard, OrderRefused
+from tradex.risk.exposure import Leg, factor_exposures
+from tradex.risk.gate import BookState, RiskGate
+from tradex.risk.options import (GAP_PCT_FLOOR, OptionInfo, load_options_policy, naked_call_blockers,
+                                 option_unit_risk, parse_option_symbol, premium_after_gap)
+
+T0 = pd.Timestamp("2026-03-02 21:00", tz="UTC")
+CALL = "US.XYZ260417C105000"
+PUT = "US.XYZ260417P095000"
+POL = load_options_policy()
+TODAY, END = dt.date(2026, 3, 3), dt.date(2026, 3, 17)
+
+
+def _plan(symbol=CALL, d=1, entry=2.50, stop=1.25, t1=5.0, p=0.5, did="o1"):
+    rr = abs(t1 - entry) / (abs(entry - stop) or 1e-9)
+    return TradePlan(did, T0.isoformat(), symbol, "options", d, "market", entry, stop, [t1], 15, "", ["trend", "breakout"],
+                     ["a", "b"], 0.5, p, "base_rate", rr, p * rr - (1 - p), 0.0)
+
+
+def _info(right="C", **kw):
+    base = dict(right=right, strike=105.0, underlying="XYZ", underlying_price=100.0, delta=0.4,
+                underlying_at_stop=103.0, iv=0.30, years=30 / 365, today=TODAY, holding_end=END,
+                earnings_known=True, earnings_date=None, short_interest_pct_float=3.0, days_to_cover=1.0)
+    return OptionInfo(**(base | kw))
+
+
+def _naked(**plan_kw):
+    return _plan(d=-1, entry=1.50, stop=3.00, t1=0.15, p=0.6, **plan_kw)
+
+
+GATE = RiskGate.from_policy()
+BOOK = BookState(100_000, [])
+
+
+# --- gate: the x100 multiplier ----------------------------------------------------------------------
+
+def test_policy_has_the_options_section():
+    assert POL["multiplier"] == 100 and POL["naked_call"]["gap_pct"] == 0.20 and POL["naked_call"]["stop_required"]
+    for tier in GATE.policy["book"]["tiers"].values():
+        assert tier["max_leverage"]["options"] > 0
+
+
+def test_long_call_is_sized_on_premium_times_100():
+    v = GATE.review(_plan(), BOOK, 1.0, option=_info())
+    assert v.outcome == "accepted"
+    assert v.risk_usd == pytest.approx(v.qty * 2.50 * 100)               # not 2.50 per contract
+    assert v.checks["options"]["multiplier"] == 100 and v.checks["options"]["structure"] == "long_call"
+    assert v.checks["options"]["unit_risk_usd"] == pytest.approx(250.0)
+    assert v.risk_pct <= GATE.policy["sizing"]["per_trade_cap_pct"] + 1e-9
+    assert v.qty == int(v.qty) and v.qty >= 1
+
+
+def test_long_put_is_sized_the_same_way():
+    v = GATE.review(_plan(PUT), BOOK, 1.0, option=_info("P"))
+    assert v.outcome == "accepted" and v.checks["options"]["structure"] == "long_put"
+    assert v.risk_usd == pytest.approx(v.qty * 250.0)
+
+
+def test_leverage_cap_counts_premium_value_with_the_multiplier():
+    tier = GATE.policy["book"]["tiers"][2]["max_leverage"]["options"]
+    cheap = _plan(entry=0.50, stop=0.25, t1=1.0, p=0.7)
+    v = GATE.review(cheap, BookState(10_000, []), 1.0, option=_info())
+    gross = v.qty * 0.50 * 100
+    assert gross <= 10_000 * tier + 1e-6
+    assert v.checks["leverage"]["cap_x"] == tier
+
+
+def test_options_plan_without_details_or_policy_is_rejected():
+    v = GATE.review(_plan(), BOOK, 1.0)
+    assert v.outcome == "rejected" and "without option details" in v.reasons[-1]
+    off = RiskGate({k: v_ for k, v_ in GATE.policy.items() if k != "options"})
+    assert "not enabled" in off.review(_plan(), BOOK, 1.0, option=_info()).reasons[-1]
+
+
+def test_short_put_is_refused():
+    v = GATE.review(_plan(PUT, d=-1, entry=1.5, stop=3.0, t1=0.5, p=0.6), BOOK, 1.0, option=_info("P"))
+    assert v.outcome == "rejected" and "short puts" in v.reasons[-1]
+
+
+def test_open_option_legs_count_in_heat_with_their_stress_loss():
+    held = [Leg("US.AAA260417C105000", "options", 1, 40, 2.50, 1.25, multiplier=100.0, underlying="AAA",
+                underlying_price=100.0, delta=0.4, right="C", stress_loss_usd=250.0)]
+    free = GATE.review(_plan(), BOOK, 1.0, option=_info())
+    crowded = GATE.review(_plan(), BookState(100_000, held), 1.0, option=_info())
+    assert crowded.checks["heat"]["now_usd"] == pytest.approx(40 * 250.0)
+    assert crowded.qty < free.qty
+
+
+def test_book_with_option_legs_missing_data_blocks_every_trade():
+    stray = [Leg("US.AAA260417C105000", "options", 1, 4, 2.50, 1.25)]       # no multiplier, no underlying price
+    v = GATE.review(_plan(), BookState(100_000, stray), 1.0, option=_info())
+    assert v.outcome == "rejected" and "cannot be measured" in v.reasons[-1]
+
+
+def test_expected_profit_uses_the_plans_own_r_with_the_multiplier():
+    v = GATE.review(_plan(), BOOK, 1.0, fee_fn=lambda q: 0.0, option=_info())
+    r_unit = abs(2.50 - 1.25) * 100
+    assert v.checks["economics"]["expected_profit_usd"] == pytest.approx(_plan().ev_r * v.qty * r_unit, abs=0.01)
+
+
+def test_stock_and_forex_paths_are_unchanged():
+    stock = TradePlan("s", T0.isoformat(), "X", "stocks", 1, "market", 100.0, 99.0, [103.0], 10, "", ["a", "b"], ["a", "b"],
+                      0.5, 0.6, "base_rate", 3.0, 1.2, 0.0)
+    v = GATE.review(stock, BookState(10_000, []), 1.0)
+    assert v.outcome == "accepted" and "options" not in v.checks
+
+
+# --- gate: naked calls -----------------------------------------------------------------------------
+
+def test_naked_call_is_sized_on_the_gap_stressed_loss():
+    v = GATE.review(_naked(), BOOK, 1.0, option=_info())
+    assert v.outcome == "accepted"
+    o = v.checks["options"]
+    assert o["structure"] == "naked_call" and o["gap_pct"] == 0.20 and o["blockers"] == []
+    assert o["unit_risk_usd"] > 20 * o["stop_loss_usd"] / 3                  # far more than the loss at the stop
+    assert v.risk_usd == pytest.approx(v.qty * o["unit_risk_usd"], abs=0.01)
+    assert v.risk_usd <= 100_000 * GATE.policy["sizing"]["per_trade_cap_pct"] / 100 + 1e-6
+    assert o["underlying_after_gap"] == pytest.approx(103.0 * 1.2)
+
+
+def test_naked_call_without_a_stop_is_rejected():
+    for stop in (1.50, 1.0, 0.0):
+        v = GATE.review(_plan(d=-1, entry=1.50, stop=stop, t1=0.15, p=0.6), BOOK, 1.0, option=_info())
+        assert v.outcome == "rejected" and "buy-to-close stop above the credit" in v.reasons[-1], stop
+
+
+def test_naked_call_needs_the_underlying_level_at_the_stop():
+    v = GATE.review(_naked(), BOOK, 1.0, option=_info(underlying_at_stop=None))
+    assert v.outcome == "rejected" and "gap cannot be sized" in v.reasons[-1]
+
+
+def test_gap_floor_is_in_code_not_just_in_config():
+    weak = dict(GATE.policy)
+    weak["options"] = {**POL, "naked_call": {**POL["naked_call"], "gap_pct": 0.02}}
+    v = RiskGate(weak).review(_naked(), BOOK, 1.0, option=_info())
+    assert v.outcome == "accepted" and v.checks["options"]["gap_pct"] == GAP_PCT_FLOOR
+    assert v.risk_usd == pytest.approx(GATE.review(_naked(), BOOK, 1.0, option=_info()).risk_usd, rel=0.2)
+
+
+def test_naked_calls_can_be_switched_off():
+    off = dict(GATE.policy)
+    off["options"] = {**POL, "naked_call": {**POL["naked_call"], "enabled": False}}
+    assert "not enabled" in RiskGate(off).review(_naked(), BOOK, 1.0, option=_info()).reasons[-1]
+
+
+def test_naked_call_blocked_through_earnings_and_on_squeeze_names():
+    near = _info(earnings_date=dt.date(2026, 3, 10))
+    v = GATE.review(_naked(), BOOK, 1.0, option=near)
+    assert v.outcome == "rejected" and "earnings" in v.reasons[-1]
+    assert GATE.review(_naked(), BOOK, 1.0, option=_info(earnings_date=dt.date(2026, 3, 18))).outcome == "rejected"   # buffer day
+    assert GATE.review(_naked(), BOOK, 1.0, option=_info(earnings_date=dt.date(2026, 3, 19))).outcome == "accepted"
+    assert "squeeze" in GATE.review(_naked(), BOOK, 1.0, option=_info(short_interest_pct_float=25.0)).reasons[-1]
+    assert "squeeze" in GATE.review(_naked(), BOOK, 1.0, option=_info(days_to_cover=6.0)).reasons[-1]
+
+
+def test_naked_call_blocked_on_unknown_data():
+    assert GATE.review(_naked(), BOOK, 1.0, option=_info(earnings_known=False)).outcome == "rejected"
+    r = GATE.review(_naked(), BOOK, 1.0, option=_info(short_interest_pct_float=None, days_to_cover=None))
+    assert r.outcome == "rejected" and "unknown_data" in r.reasons[-1]
+    assert GATE.review(_naked(), BOOK, 1.0, option=_info(earnings_date=dt.date(2026, 3, 10), today=None)).outcome == "rejected"
+
+
+def test_a_big_naked_position_in_the_book_shrinks_the_next_one():
+    unit, _, _ = option_unit_risk(1.5, 3.0, -1, _info(), POL)
+    held = [Leg("US.AAA260417C105000", "options", -1, 20, 1.5, 3.0, multiplier=100.0, underlying="AAA",
+                underlying_price=100.0, right="C", stress_loss_usd=unit)]
+    free = GATE.review(_naked(), BOOK, 1.0, option=_info())
+    crowded = GATE.review(_naked(), BookState(100_000, held), 1.0, option=_info())
+    assert crowded.qty < free.qty or crowded.outcome == "rejected"
+
+
+# --- exposure --------------------------------------------------------------------------------------
+
+def test_option_exposure_is_delta_adjusted_share_equivalent():
+    lc = Leg(CALL, "options", 1, 3, 2.5, multiplier=100.0, underlying="XYZ", underlying_price=100.0, delta=0.4, right="C")
+    lp = Leg(PUT, "options", 1, 3, 2.5, multiplier=100.0, underlying="XYZ", underlying_price=100.0, delta=-0.35, right="P")
+    sc = Leg(CALL, "options", -1, 3, 1.5, multiplier=100.0, underlying="XYZ", underlying_price=100.0, delta=0.2, right="C")
+    assert factor_exposures(lc) == {"EQ:XYZ": pytest.approx(3 * 100 * 0.4 * 100.0)}
+    assert factor_exposures(lp) == {"EQ:XYZ": pytest.approx(-3 * 100 * 0.35 * 100.0)}
+    assert factor_exposures(sc) == {"EQ:XYZ": pytest.approx(-3 * 100 * 1.0 * 100.0)}       # short call stressed as short shares
+    missing = Leg(CALL, "options", 1, 3, 2.5, multiplier=100.0, underlying="XYZ", underlying_price=100.0, right="C")
+    assert factor_exposures(missing)["EQ:XYZ"] == pytest.approx(3 * 100 * 100.0)
+    with pytest.raises(ValueError):
+        factor_exposures(Leg(CALL, "options", 1, 3, 2.5, multiplier=100.0))
+
+
+def test_sanity_check_notional_includes_the_multiplier():
+    pol = SanityPolicy(max_order_notional_x_equity=15.0)
+    # 40 contracts at 5.00 = 20,000 notional (not 200): above 15x of a 1,000 account
+    assert sanity_check(40, 5.0, 1.0, 1_000.0, None, pol, multiplier=100.0) is not None
+    assert sanity_check(40, 5.0, 1.0, 1_000.0, None, pol) is None
+
+
+def test_parse_option_symbol():
+    s = parse_option_symbol(CALL)
+    assert (s.underlying, s.expiry, s.right, s.strike) == ("XYZ", dt.date(2026, 4, 17), "C", 105.0)
+    assert parse_option_symbol("US.XYZ") is None and parse_option_symbol("EUR_USD") is None
+
+
+# --- order guard -----------------------------------------------------------------------------------
+
+def _sized(plan, info):
+    v = GATE.review(plan, BOOK, 1.0, option=info)
+    assert v.outcome == "accepted", v.reasons
+    v.verdict_id = f"{plan.decision_id}-v"
+    return v
+
+
+def _guard(v, accounts=("acct-1",), pol=None):
+    return OrderGuard(lambda did, vid: v if vid == v.verdict_id else None, accounts, pol)
+
+
+def _order(v, symbol=CALL, side=1, qty=None, stop=None, **kw):
+    return OrderRequest("o1-entry", "o1", symbol, "options", side, qty if qty is not None else v.qty,
+                        stop_loss=stop, verdict_id=v.verdict_id, **kw)
+
+
+def test_guard_passes_long_options_sized_by_the_gate():
+    v = _sized(_plan(), _info())
+    _guard(v).check(_order(v), "acct-1", [])
+    vp = _sized(_plan(PUT), _info("P"))
+    _guard(vp).check(_order(vp, PUT), "acct-1", [])
+
+
+def test_guard_passes_a_naked_call_with_its_stop():
+    v = _sized(_naked(), _info())
+    _guard(v).check(_order(v, side=-1, stop=3.0), "acct-1", [])
+    _guard(v).check(_order(v, side=-1, stop=2.4), "acct-1", [])             # tighter than sized is fine
+
+
+def test_guard_refuses_a_naked_call_without_a_stop():
+    v = _sized(_naked(), _info())
+    for stop in (None, 0.0):
+        with pytest.raises(OrderRefused, match="without a buy-to-close stop"):
+            _guard(v).check(_order(v, side=-1, stop=stop), "acct-1", [])
+    with pytest.raises(OrderRefused, match="not above the credit"):
+        _guard(v).check(_order(v, side=-1, stop=1.5), "acct-1", [])
+    with pytest.raises(OrderRefused, match="looser than"):
+        _guard(v).check(_order(v, side=-1, stop=3.5), "acct-1", [])
+
+
+def test_guard_refuses_short_puts_and_non_option_symbols():
+    v = _sized(_plan(PUT), _info("P"))
+    with pytest.raises(OrderRefused, match="short puts"):
+        _guard(v).check(_order(v, PUT, side=-1, stop=3.0), "acct-1", [])
+    with pytest.raises(OrderRefused, match="not an option contract code"):
+        _guard(v).check(_order(v, "EUR_USD"), "acct-1", [])
+
+
+def test_guard_refuses_verdicts_not_sized_for_options():
+    stock_like = Verdict("o1", T0.isoformat(), "accepted", 5, 50, 0.5, [], {}, verdict_id="o1-v")
+    with pytest.raises(OrderRefused, match="no options sizing"):
+        _guard(stock_like).check(_order(stock_like, qty=5), "acct-1", [])
+    wrong_mult = Verdict("o1", T0.isoformat(), "accepted", 5, 50, 0.5, [], {"options": {"multiplier": 1, "right": "C"}},
+                         verdict_id="o1-v")
+    with pytest.raises(OrderRefused, match="x100 contract multiplier"):
+        _guard(wrong_mult).check(_order(wrong_mult, qty=5), "acct-1", [])
+    v = _sized(_plan(), _info())
+    with pytest.raises(OrderRefused, match="sized for a C"):
+        _guard(v).check(_order(v, PUT), "acct-1", [])
+
+
+def test_guard_refuses_fractional_contracts_and_over_size():
+    v = _sized(_plan(), _info())
+    with pytest.raises(OrderRefused, match="whole number"):
+        _guard(v).check(_order(v, qty=v.qty - 0.5), "acct-1", [])
+    with pytest.raises(OrderRefused, match="exceeds verdict size"):
+        _guard(v).check(_order(v, qty=v.qty + 1), "acct-1", [])
+
+
+def test_guard_refuses_a_naked_call_whose_verdict_lacks_the_gap_stress_or_has_blockers():
+    v = _sized(_naked(), _info())
+    v.checks["options"]["gap_pct"] = 0.05
+    with pytest.raises(OrderRefused, match="required gap"):
+        _guard(v).check(_order(v, side=-1, stop=3.0), "acct-1", [])
+    v = _sized(_naked(), _info())
+    v.checks["options"]["blockers"] = ["earnings: report inside the window"]
+    with pytest.raises(OrderRefused, match="blocked"):
+        _guard(v).check(_order(v, side=-1, stop=3.0), "acct-1", [])
+
+
+def test_guard_refuses_options_when_the_policy_has_no_options_section(monkeypatch):
+    import tradex.execution.guard as guard_mod
+    v = _sized(_plan(), _info())
+    monkeypatch.setattr(guard_mod, "load_options_policy", lambda: None)
+    with pytest.raises(OrderRefused, match="not enabled"):
+        OrderGuard(lambda did, vid: v, ("acct-1",)).check(_order(v), "acct-1", [])
+
+
+def test_guard_still_enforces_the_account_rules_for_options():
+    v = _sized(_plan(), _info())
+    with pytest.raises(OrderRefused, match="not listed as agent-owned"):
+        _guard(v).check(_order(v), "acct-9", [])
+    with pytest.raises(OrderRefused, match="Ray's own account"):
+        _guard(v).check(_order(v, account="ray"), "acct-1", [])
+    with pytest.raises(OrderRefused, match="no risk-gate verdict"):
+        _guard(v).check(OrderRequest("x", "o1", CALL, "options", 1, 1), "acct-1", [])
+
+
+def test_exits_close_option_positions_without_a_verdict():
+    pos = [BrokerPosition("o1", CALL, "options", -1, 3, 1.5, T0, 3.0, None)]
+    ok = OrderRequest("o1-x", "o1", CALL, "options", 1, 3, purpose="exit")
+    OrderGuard(lambda *_: None, ("acct-1",)).check(ok, "acct-1", pos)               # buy to close a short call
+    for bad in (OrderRequest("o1-x", "o1", CALL, "options", 1, 4, purpose="exit"),
+                OrderRequest("o1-x", "o1", CALL, "options", -1, 3, purpose="exit")):
+        with pytest.raises(OrderRefused):
+            OrderGuard(lambda *_: None, ("acct-1",)).check(bad, "acct-1", pos)
+
+
+def test_accounts_file_lists_options_for_the_moomoo_simulate_account():
+    from tradex.execution.accounts import load_accounts
+    mm = [a for a in load_accounts(resolve=lambda n: None) if a.venue == "moomoo"][0]
+    assert "options" in mm.asset_classes and mm.mode == "paper" and mm.environment == "SIMULATE"
+
+
+# --- the protected gap formula agrees with the unprotected sizing module -------------------------------
+
+@pytest.mark.parametrize("strike,credit,stop,s_stop,iv,years", [
+    (105, 1.5, 3.0, 103.0, 0.30, 30 / 365), (105, 1.5, 3.0, 103.0, None, None), (50, 0.4, 0.8, 48.0, 0.6, 0.1),
